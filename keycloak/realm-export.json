{
  "realm": "quiz-dock",
  "enabled": true,
  "displayName": "QuizDock",
  "bruteForceProtected": true,
  "roles": {
    "client": {
      "quiz-dock-frontend": [
        {
          "name": "host",
          "description": "Hosts quizzes and creates them",
          "clientRole": true
        },
        {
          "name": "player",
          "description": "Signed-in participant",
          "clientRole": true
        },
        {
          "name": "admin",
          "description": "Administers the instance",
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "quiz-dock-frontend",
      "name": "QuizDock Frontend (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_APP_URL:http://localhost:18081}/auth/callback",
        "${KEYCLOAK_DEV_URL:http://localhost:15173}/auth/callback",
        "http://localhost:15173/auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KEYCLOAK_APP_URL:http://localhost:18081}##${KEYCLOAK_DEV_URL:http://localhost:15173}##http://localhost:15173"
      },
      "webOrigins": [
        "${KEYCLOAK_APP_URL:http://localhost:18081}",
        "${KEYCLOAK_DEV_URL:http://localhost:15173}",
        "http://localhost:15173"
      ],
      "protocolMappers": [
        {
          "name": "quizdock roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "quiz-dock-frontend",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "2bca0877-373c-460c-a37d-6520be91d3b4",
      "username": "host",
      "enabled": true,
      "email": "host@quiz-dock.test",
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Host",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_HOST_PASSWORD:animateur}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "clientRoles": {
        "quiz-dock-frontend": ["host", "admin"]
      }
    },
    {
      "id": "39b95ebf-1a3f-4b7f-a53e-105e57137962",
      "username": "player",
      "enabled": true,
      "email": "player@quiz-dock.test",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Player",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_PLAYER_PASSWORD:participant}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "clientRoles": {
        "quiz-dock-frontend": ["player"]
      }
    }
  ]
}
