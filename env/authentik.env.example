# QuizDock + bundled Authentik. Copy to .env beside docker-compose.prod.yml, with
# docker-compose.authentik.yml and authentik/quizdock.yaml, then run:
#   docker compose -f docker-compose.prod.yml -f docker-compose.authentik.yml up -d
# The quizdock CLI can generate this file with random secrets: ./quizdock init --full --iam=authentik

QUIZDOCK_MODE=full
QUIZDOCK_IAM=authentik
QUIZDOCK_TAG=latest
HTTP_PORT=18080
AUTHENTIK_PORT=18081

# Use one hostname/IP reachable by every browser. Both services use it, on
# separate ports. For public TLS, set PUBLIC_SCHEME=https and proxy both ports.
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http
APP_NAME=QuizDock
APP_LANG=en

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database
POSTGRES_DB=quizdock
# QuizDock's own role: it owns the database above and nothing else (set before the first start).
QUIZDOCK_DB_USER=quizdock
QUIZDOCK_DB_PASSWORD=change-me-app-db

AUTH_MODE=oidc
OIDC_CLIENT_ID=quiz-dock
# Shared with Authentik: authentik/quizdock.yaml gives the client this secret.
OIDC_CLIENT_SECRET=change-me-client-secret
OIDC_INTERNAL_URL=http://authentik-server:9000
# `entitlements` brings the roles in the ID token, `offline_access` the refresh token.
OIDC_SCOPE=openid profile email entitlements offline_access
OIDC_ROLES_CLAIM=roles
ALLOW_ANONYMOUS_PARTICIPANTS=true

# Change every secret before the first start; Authentik loads authentik/quizdock.yaml
# then, and never overwrites what was changed in its interface afterwards.
# Authentik's administrator is `akadmin`; host and player are demonstration accounts.
AUTHENTIK_ADMIN_PASSWORD=change-me-admin
AUTHENTIK_HOST_PASSWORD=change-me-host
AUTHENTIK_PLAYER_PASSWORD=change-me-player
# Signs Authentik's cookies and sessions: a long random string.
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key
# Authentik's own PostgreSQL role: its database belongs to it.
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=change-me-authentik-db

# Optional overrides for a reverse proxy that changes the public ports/paths:
# APP_PUBLIC_URL=https://quiz.example.org
# AUTHENTIK_PUBLIC_URL=https://id.example.org
# OIDC_ISSUER=https://id.example.org/application/o/quiz-dock/
