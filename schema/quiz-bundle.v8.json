          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "peaks": {
            "minItems": 200,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "upload",
              "recording"
            ]
          },
          "loudnessLufs": {
            "type": "number",
            "minimum": -70,
            "maximum": 0
          },
          "peakDbfs": {
            "type": "number",
            "minimum": -100,
            "maximum": 6
          }
        }
      }
    },
