              "minLength": 1,
              "maxLength": 40
            }
          },
          "required": [
            "builtin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "maxLength": 60,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
