                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9.+-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "parent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "overrides": {
              "type": "object",
              "properties": {
                "background": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
